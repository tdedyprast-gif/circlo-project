{
    "version": 2,
    "buildCommand": "curl -sS https://getcomposer.org/installer | php && php composer.phar install --no-dev --optimize-autoloader --no-scripts && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 2048,
            "maxDuration": 30,
            "includeFiles": "**/*.php,**/*.env,!node_modules/**"
        }
    },
    "routes": [
        {
            "src": "/vendor/filament/(.*)",
            "dest": "/public/vendor/filament/$1"
        },
        {
            "src": "/js/filament/(.*)",
            "dest": "/public/js/filament/$1"
        },
        {
            "src": "/css/filament/(.*)",
            "dest": "/public/css/filament/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/vendor/(.*)",
            "dest": "/public/vendor/$1"
        },
        {
            "src": "/img/(.*)",
            "dest": "/public/img/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}